# ArduBlock — variables de entorno
# Copiar a .env y rellenar con valores reales

# Teacher por defecto (primer inicio)
TEACHER_EMAIL=javier@matemancia.net
TEACHER_PASSWORD=change-me

# Clave de sesión: generar con `python -c "import secrets; print(secrets.token_hex(32))"`.
# Sin ella, las sesiones (login "recordarme") se invalidan en cada reinicio.
ARDUBLOCK_SECRET_KEY=change-me

# Email SMTP (registro, recuperación de contraseña)
# Puerto 465 = SMTP_SSL (TLS implícito). El código usa SMTP_SSL si el puerto es 465.
SMTP_HOST=mail.mortem.technology
SMTP_PORT=465
SMTP_USER=ardublock@matemancia.net
SMTP_PASS=change-me
